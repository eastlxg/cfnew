import { connect } from 'cloudflare:sockets';

// ============================================================
// Cloudflare Worker
// 环境变量：UUID
// ============================================================

const WS_READY_STATE_OPEN = 1;
const WS_READY_STATE_CLOSING = 2;

export default {
  async fetch(request, env, ctx) {
    try {
      // 从环境变量读取 UUID
      const userID = env.UUID;

      if (!userID) {
        return new Response(
          'UUID environment variable is not configured',
          { status: 500 }
        );
      }

      // 检查 UUID 基本格式
      if (!isValidUUID(userID)) {
        return new Response(
          'Invalid UUID environment variable',
          { status: 500 }
        );
      }

      const url = new URL(request.url);

      // ========================================================
      // 检查 WebSocket
      // ========================================================

      const upgradeHeader =
        request.headers.get('Upgrade');

      if (
        !upgradeHeader ||
        upgradeHeader.toLowerCase() !== 'websocket'
      ) {
        // 根路径
        if (url.pathname === '/') {
          return new Response(
            'VLESS Proxy Server',
            {
              status: 200,
              headers: {
                'Content-Type':
                  'text/plain;charset=utf-8',
              },
            }
          );
        }

        // /UUID 返回 VLESS 配置
        if (url.pathname === `/${userID}`) {
          const host =
            request.headers.get('Host');

          if (!host) {
            return new Response(
              'Host header missing',
              { status: 400 }
            );
          }

          const vlessConfig =
            `vless://${userID}@${host}:443` +
            `?encryption=none` +
            `&security=tls` +
            `&sni=${encodeURIComponent(host)}` +
            `&type=ws` +
            `&host=${encodeURIComponent(host)}` +
            `&path=%2F` +
            `#${encodeURIComponent(host)}`;

          return new Response(
            vlessConfig,
            {
              status: 200,
              headers: {
                'Content-Type':
                  'text/plain;charset=utf-8',
              },
            }
          );
        }

        return new Response(
          'Not Found',
          { status: 404 }
        );
      }

      // ========================================================
      // WebSocket
      // ========================================================

      // VLESS WS Path = /
      if (url.pathname !== '/') {
        return new Response(
          'Not Found',
          { status: 404 }
        );
      }

      return await handleVLESSWebSocket(
        request,
        userID
      );

    } catch (err) {
      console.error(
        'Worker error:',
        err
      );

      return new Response(
        err?.message || String(err),
        { status: 500 }
      );
    }
  },
};


// ============================================================
// VLESS WebSocket
// ============================================================

async function handleVLESSWebSocket(
  request,
  userID
) {
  const wsPair =
    new WebSocketPair();

  const clientWS =
    wsPair[0];

  const serverWS =
    wsPair[1];

  serverWS.accept();

  // VLESS early data
  const earlyDataHeader =
    request.headers.get(
      'sec-websocket-protocol'
    ) || '';

  const wsReadable =
    createWebSocketReadableStream(
      serverWS,
      earlyDataHeader
    );

  let remoteSocket = null;

  let udpStreamWrite = null;

  let isDns = false;

  wsReadable
    .pipeTo(
      new WritableStream({

        async write(chunk) {

          try {

            // ==================================================
            // DNS UDP 已建立
            // ==================================================

            if (
              isDns &&
              udpStreamWrite
            ) {
              await udpStreamWrite(
                chunk
              );
              return;
            }

            // ==================================================
            // TCP 已建立
            // ==================================================

            if (remoteSocket) {

              const writer =
                remoteSocket
                  .writable
                  .getWriter();

              try {
                await writer.write(
                  chunk
                );
              } finally {
                writer.releaseLock();
              }

              return;
            }

            // ==================================================
            // 解析 VLESS Header
            // ==================================================

            const result =
              parseVLESSHeader(
                chunk,
                userID
              );

            if (result.hasError) {
              throw new Error(
                result.message
              );
            }

            // VLESS response header
            const vlessRespHeader =
              new Uint8Array([
                result.vlessVersion[0],
                0,
              ]);

            // Header 后面的原始数据
            const rawClientData =
              chunk.slice(
                result.rawDataIndex
              );

            // ==================================================
            // UDP
            // ==================================================

            if (result.isUDP) {

              // 原代码逻辑：
              // UDP 只支持 DNS 53
              if (
                result.portRemote !== 53
              ) {
                throw new Error(
                  'UDP proxy only supports DNS port 53'
                );
              }

              isDns = true;

              const {
                write,
              } =
                await handleUDPOutBound(
                  serverWS,
                  vlessRespHeader
                );

              udpStreamWrite =
                write;

              if (
                rawClientData.byteLength > 0
              ) {
                await udpStreamWrite(
                  rawClientData
                );
              }

              return;
            }

            // ==================================================
            // TCP
            // ==================================================

            async function connectAndWrite(
              address,
              port
            ) {
              const tcpSocket =
                await connect({
                  hostname: address,
                  port: port,
                });

              remoteSocket =
                tcpSocket;

              const writer =
                tcpSocket
                  .writable
                  .getWriter();

              try {
                if (
                  rawClientData.byteLength > 0
                ) {
                  await writer.write(
                    rawClientData
                  );
                }
              } finally {
                writer.releaseLock();
              }

              return tcpSocket;
            }

            // ==================================================
            // 原代码的 NAT64 fallback
            // ==================================================

            async function retry() {
              try {

                const proxyIP =
                  await getIPv6ProxyAddress(
                    result.addressRemote
                  );

                console.log(
                  `Trying NAT64 IPv6 address: ${proxyIP}`
                );

                const tcpSocket =
                  await connect({
                    hostname: proxyIP,
                    port: result.portRemote,
                  });

                remoteSocket =
                  tcpSocket;

                const writer =
                  tcpSocket
                    .writable
                    .getWriter();

                try {
                  if (
                    rawClientData.byteLength > 0
                  ) {
                    await writer.write(
                      rawClientData
                    );
                  }
                } finally {
                  writer.releaseLock();
                }

                pipeRemoteToWebSocket(
                  tcpSocket,
                  serverWS,
                  vlessRespHeader,
                  null
                );

              } catch (err) {

                console.error(
                  'NAT64 connection failed:',
                  err
                );

                safeCloseWebSocket(
                  serverWS,
                  1011,
                  'NAT64 connection failed'
                );
              }
            }

            // ==================================================
            // 第一次直接 TCP 连接
            // ==================================================

            try {

              const tcpSocket =
                await connectAndWrite(
                  result.addressRemote,
                  result.portRemote
                );

              pipeRemoteToWebSocket(
                tcpSocket,
                serverWS,
                vlessRespHeader,
                retry
              );

            } catch (err) {

              // 保留原代码逻辑：
              // 第一次 TCP 失败后，由 pipe 的 retry 机制
              // 进行 NAT64 fallback。
              console.error(
                'TCP connection failed:',
                err
              );

              // 原代码这里直接关闭；
              // 为了真正执行 fallback，
              // 这里直接调用 retry。
              await retry();
            }

          } catch (err) {

            console.error(
              'WebSocket processing error:',
              err
            );

            closeSocket(
              remoteSocket
            );

            safeCloseWebSocket(
              serverWS,
              1011,
              'Internal error'
            );
          }
        },

        close() {
          closeSocket(
            remoteSocket
          );
        },

        abort() {
          closeSocket(
            remoteSocket
          );
        },
      })
    )
    .catch(err => {

      console.error(
        'WebSocket stream error:',
        err
      );

      closeSocket(
        remoteSocket
      );

      safeCloseWebSocket(
        serverWS,
        1011,
        'Internal error'
      );
    });

  return new Response(
    null,
    {
      status: 101,
      webSocket: clientWS,
    }
  );
}


// ============================================================
// WebSocket ReadableStream
// ============================================================

function createWebSocketReadableStream(
  ws,
  earlyDataHeader
) {
  return new ReadableStream({

    start(controller) {

      ws.addEventListener(
        'message',
        event => {

          try {
            controller.enqueue(
              event.data
            );
          } catch (err) {
            controller.error(
              err
            );
          }
        }
      );

      ws.addEventListener(
        'close',
        () => {

          try {
            controller.close();
          } catch {}
        }
      );

      ws.addEventListener(
        'error',
        err => {
          controller.error(
            err
          );
        }
      );

      // ========================================================
      // Early Data
      // ========================================================

      if (earlyDataHeader) {

        try {

          const decoded =
            atob(
              earlyDataHeader
                .replace(/-/g, '+')
                .replace(/_/g, '/')
            );

          const data =
            Uint8Array.from(
              decoded,
              c => c.charCodeAt(0)
            );

          controller.enqueue(
            data.buffer
          );

        } catch {
          // 忽略 Early Data 解码错误
        }
      }
    },
  });
}


// ============================================================
// VLESS Header Parser
// ============================================================

function parseVLESSHeader(
  buffer,
  userID
) {
  // 最小头部长度
  if (
    !buffer ||
    buffer.byteLength < 24
  ) {
    return {
      hasError: true,
      message:
        'Invalid VLESS header length',
    };
  }

  try {

    const view =
      new DataView(buffer);

    const version =
      new Uint8Array(
        buffer.slice(0, 1)
      );

    // ========================================================
    // UUID
    // ========================================================

    const uuid =
      formatUUID(
        new Uint8Array(
          buffer.slice(1, 17)
        )
      );

    if (
      uuid.toLowerCase() !==
      userID.toLowerCase()
    ) {
      return {
        hasError: true,
        message:
          'Invalid user UUID',
      };
    }

    // ========================================================
    // Options
    // ========================================================

    const optionsLength =
      view.getUint8(17);

    const commandOffset =
      18 + optionsLength;

    if (
      commandOffset >=
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message:
          'Invalid VLESS command offset',
      };
    }

    const command =
      view.getUint8(
        commandOffset
      );

    let isUDP = false;

    // 01 TCP
    if (
      command === 1
    ) {
      isUDP = false;
    }

    // 02 UDP
    else if (
      command === 2
    ) {
      isUDP = true;
    }

    else {
      return {
        hasError: true,
        message:
          'Unsupported command, only TCP(01) and UDP(02)',
      };
    }

    // ========================================================
    // Port
    // ========================================================

    let offset =
      commandOffset + 1;

    if (
      offset + 2 >
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message:
          'Invalid port',
      };
    }

    const port =
      view.getUint16(offset);

    offset += 2;

    // ========================================================
    // Address
    // ========================================================

    if (
      offset >=
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message:
          'Missing address type',
      };
    }

    const addressType =
      view.getUint8(offset++);

    let address = '';

    // IPv4
    switch (addressType) {

      case 1: {

        if (
          offset + 4 >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Invalid IPv4 address',
          };
        }

        address =
          Array.from(
            new Uint8Array(
              buffer.slice(
                offset,
                offset + 4
              )
            )
          ).join('.');

        offset += 4;

        break;
      }

      // Domain
      case 2: {

        if (
          offset >=
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Missing domain length',
          };
        }

        const domainLength =
          view.getUint8(
            offset++
          );

        if (
          offset + domainLength >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Invalid domain length',
          };
        }

        address =
          new TextDecoder().decode(
            buffer.slice(
              offset,
              offset + domainLength
            )
          );

        offset +=
          domainLength;

        break;
      }

      // IPv6
      case 3: {

        if (
          offset + 16 >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Invalid IPv6 address',
          };
        }

        const ipv6 = [];

        for (
          let i = 0;
          i < 8;
          i++
        ) {
          ipv6.push(
            view
              .getUint16(offset)
              .toString(16)
              .padStart(4, '0')
          );

          offset += 2;
        }

        address =
          ipv6.join(':');

        break;
      }

      default:

        return {
          hasError: true,
          message:
            'Unsupported address type',
        };
    }

    return {
      hasError: false,
      addressRemote: address,
      portRemote: port,
      rawDataIndex: offset,
      vlessVersion: version,
      isUDP,
    };

  } catch (err) {

    return {
      hasError: true,
      message:
        `VLESS parse error: ${err.message}`,
    };
  }
}


// ============================================================
// NAT64 IPv4 -> IPv6
// ============================================================

function convertToNAT64IPv6(
  ipv4Address
) {
  const parts =
    ipv4Address.split('.');

  if (
    parts.length !== 4
  ) {
    throw new Error(
      'Invalid IPv4 address'
    );
  }

  const hex =
    parts.map(part => {

      const num =
        parseInt(
          part,
          10
        );

      if (
        num < 0 ||
        num > 255 ||
        !Number.isInteger(num)
      ) {
        throw new Error(
          'Invalid IPv4 address segment'
        );
      }

      return num
        .toString(16)
        .padStart(2, '0');
    });

  // ========================================================
  // 保留原代码的 NAT64 前缀
  // ========================================================

  return (
    `[2001:67c:2960:6464::` +
    `${hex[0]}${hex[1]}:` +
    `${hex[2]}${hex[3]}]`
  );
}


// ============================================================
// DNS 查询 IPv4
// ============================================================

async function getIPv6ProxyAddress(
  domain
) {
  try {

    const dnsQuery =
      await fetch(
        `https://1.1.1.1/dns-query?name=${encodeURIComponent(domain)}&type=A`,
        {
          headers: {
            Accept:
              'application/dns-json',
          },
        }
      );

    if (!dnsQuery.ok) {
      throw new Error(
        `DNS HTTP ${dnsQuery.status}`
      );
    }

    const dnsResult =
      await dnsQuery.json();

    if (
      dnsResult.Answer &&
      dnsResult.Answer.length > 0
    ) {

      const aRecord =
        dnsResult.Answer.find(
          record =>
            record.type === 1
        );

      if (aRecord) {

        const ipv4Address =
          aRecord.data;

        return convertToNAT64IPv6(
          ipv4Address
        );
      }
    }

    throw new Error(
      'Unable to resolve IPv4 address'
    );

  } catch (err) {

    throw new Error(
      `DNS resolution failed: ${err.message}`
    );
  }
}


// ============================================================
// Remote TCP -> WebSocket
// ============================================================

function pipeRemoteToWebSocket(
  remoteSocket,
  ws,
  vlessHeader,
  retry = null
) {
  let headerSent = false;
  let hasIncomingData = false;

  remoteSocket.readable
    .pipeTo(
      new WritableStream({

        write(chunk) {

          hasIncomingData = true;

          if (
            ws.readyState !==
            WS_READY_STATE_OPEN
          ) {
            return;
          }

          if (!headerSent) {

            const combined =
              new Uint8Array(
                vlessHeader.byteLength +
                chunk.byteLength
              );

            combined.set(
              new Uint8Array(
                vlessHeader
              ),
              0
            );

            combined.set(
              new Uint8Array(
                chunk
              ),
              vlessHeader.byteLength
            );

            ws.send(
              combined.buffer
            );

            headerSent = true;

          } else {

            ws.send(
              chunk
            );
          }
        },

        close() {

          // 保留原代码的 retry 机制
          if (
            !hasIncomingData &&
            retry
          ) {
            retry();
            return;
          }

          safeCloseWebSocket(
            ws,
            1000,
            'Connection closed'
          );
        },

        abort() {
          closeSocket(
            remoteSocket
          );
        },
      })
    )
    .catch(err => {

      console.error(
        'Remote pipe error:',
        err
      );

      closeSocket(
        remoteSocket
      );

      safeCloseWebSocket(
        ws,
        1011,
        'Data transfer error'
      );
    });
}


// ============================================================
// UDP DNS
// ============================================================

async function handleUDPOutBound(
  webSocket,
  vlessResponseHeader
) {
  let isVlessHeaderSent = false;

  const transformStream =
    new TransformStream({

      transform(
        chunk,
        controller
      ) {

        for (
          let index = 0;
          index < chunk.byteLength;
        ) {

          if (
            index + 2 >
            chunk.byteLength
          ) {
            throw new Error(
              'Invalid UDP packet'
            );
          }

          const lengthBuffer =
            chunk.slice(
              index,
              index + 2
            );

          const udpPacketLength =
            new DataView(
              lengthBuffer
            ).getUint16(0);

          index += 2;

          if (
            index +
              udpPacketLength >
            chunk.byteLength
          ) {
            throw new Error(
              'Invalid UDP packet length'
            );
          }

          const udpData =
            new Uint8Array(
              chunk.slice(
                index,
                index +
                  udpPacketLength
              )
            );

          index +=
            udpPacketLength;

          controller.enqueue(
            udpData
          );
        }
      },
    });

  transformStream.readable
    .pipeTo(
      new WritableStream({

        async write(chunk) {

          const resp =
            await fetch(
              'https://1.1.1.1/dns-query',
              {
                method: 'POST',
                headers: {
                  'content-type':
                    'application/dns-message',
                },
                body: chunk,
              }
            );

          if (!resp.ok) {
            throw new Error(
              `DNS request failed: ${resp.status}`
            );
          }

          const dnsQueryResult =
            await resp.arrayBuffer();

          const udpSize =
            dnsQueryResult.byteLength;

          const udpSizeBuffer =
            new Uint8Array([
              (udpSize >> 8) & 0xff,
              udpSize & 0xff,
            ]);

          if (
            webSocket.readyState !==
            WS_READY_STATE_OPEN
          ) {
            return;
          }

          const prefix =
            isVlessHeaderSent
              ? new Uint8Array(0)
              : vlessResponseHeader;

          const output =
            new Uint8Array(
              prefix.byteLength +
              2 +
              udpSize
            );

          let offset = 0;

          if (
            !isVlessHeaderSent
          ) {
            output.set(
              vlessResponseHeader,
              offset
            );

            offset +=
              vlessResponseHeader.byteLength;

            isVlessHeaderSent =
              true;
          }

          output.set(
            udpSizeBuffer,
            offset
          );

          offset += 2;

          output.set(
            new Uint8Array(
              dnsQueryResult
            ),
            offset
          );

          webSocket.send(
            output.buffer
          );
        },
      })
    )
    .catch(error => {

      console.error(
        'UDP DNS processing error:',
        error
      );

      safeCloseWebSocket(
        webSocket,
        1011,
        'DNS processing error'
      );
    });

  const writer =
    transformStream
      .writable
      .getWriter();

  return {
    write(chunk) {
      return writer.write(
        chunk
      );
    },
  };
}


// ============================================================
// UUID
// ============================================================

function formatUUID(bytes) {
  const hex =
    Array.from(
      bytes,
      b =>
        b.toString(16)
          .padStart(2, '0')
    ).join('');

  return (
    `${hex.slice(0, 8)}-` +
    `${hex.slice(8, 12)}-` +
    `${hex.slice(12, 16)}-` +
    `${hex.slice(16, 20)}-` +
    `${hex.slice(20)}`
  );
}


// ============================================================
// UUID 格式检查
// 不强制要求 UUID v4
// ============================================================

function isValidUUID(uuid) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
    uuid
  );
}


// ============================================================
// 安全关闭 WebSocket
// ============================================================

function safeCloseWebSocket(
  ws,
  code,
  reason
) {
  try {

    if (
      ws &&
      ws.readyState ===
        WS_READY_STATE_OPEN
    ) {
      ws.close(
        code,
        reason
      );
    }

  } catch {}
}


// ============================================================
// 安全关闭 Socket
// ============================================================

function closeSocket(socket) {
  if (!socket) {
    return;
  }

  try {
    socket.close();
  } catch {}
}
