import { connect } from 'cloudflare:sockets';

// ============================================================
// 只需要修改这里
// ============================================================

const USER_UUID = '把你自己的UUID填在这里';

// 例如：
// const USER_UUID = 'fe0ed675-bc05-474d-99e5-28ba9edf845a';


// ============================================================
// 常量
// ============================================================

const WS_OPEN = 1;


// ============================================================
// Worker
// ============================================================

export default {
  async fetch(request) {
    try {
      if (!isValidUUID(USER_UUID)) {
        return new Response(
          'Invalid USER_UUID in source code',
          { status: 500 }
        );
      }

      const url = new URL(request.url);

      const upgrade =
        request.headers.get('Upgrade');

      // ======================================================
      // 普通 HTTP 请求
      // ======================================================

      if (
        !upgrade ||
        upgrade.toLowerCase() !== 'websocket'
      ) {
        // 首页
        if (url.pathname === '/') {
          return new Response(
            'VLESS Proxy Server',
            {
              status: 200,
              headers: {
                'Content-Type':
                  'text/plain;charset=utf-8',
              },
            }
          );
        }

        // /UUID
        if (
          url.pathname ===
          `/${USER_UUID}`
        ) {
          const host =
            request.headers.get('Host');

          if (!host) {
            return new Response(
              'Host header missing',
              { status: 400 }
            );
          }

          const config =
            `vless://${USER_UUID}@${host}:443` +
            `?encryption=none` +
            `&security=tls` +
            `&sni=${encodeURIComponent(host)}` +
            `&type=ws` +
            `&host=${encodeURIComponent(host)}` +
            `&path=%2F` +
            `#${encodeURIComponent(host)}`;

          return new Response(
            config,
            {
              status: 200,
              headers: {
                'Content-Type':
                  'text/plain;charset=utf-8',
              },
            }
          );
        }

        return new Response(
          'Not Found',
          { status: 404 }
        );
      }

      // ======================================================
      // WebSocket
      // ======================================================

      if (url.pathname !== '/') {
        return new Response(
          'Not Found',
          { status: 404 }
        );
      }

      return handleWebSocket(
        request,
        USER_UUID
      );

    } catch (err) {
      console.error(err);

      return new Response(
        `Internal Server Error: ${
          err?.message || String(err)
        }`,
        { status: 500 }
      );
    }
  },
};


// ============================================================
// WebSocket
// ============================================================

async function handleWebSocket(
  request,
  userUUID
) {
  const pair =
    new WebSocketPair();

  const client =
    pair[0];

  const server =
    pair[1];

  server.accept();

  const earlyData =
    request.headers.get(
      'sec-websocket-protocol'
    ) || '';

  const readable =
    createWebSocketStream(
      server,
      earlyData
    );

  let remoteSocket = null;
  let dnsMode = false;
  let udpWrite = null;

  readable.pipeTo(
    new WritableStream({

      async write(chunk) {

        // DNS UDP
        if (
          dnsMode &&
          udpWrite
        ) {
          await udpWrite(chunk);
          return;
        }

        // 已经连接远程 TCP
        if (remoteSocket) {

          const writer =
            remoteSocket.writable
              .getWriter();

          try {
            await writer.write(
              chunk
            );
          } finally {
            writer.releaseLock();
          }

          return;
        }

        // ==================================================
        // VLESS Header
        // ==================================================

        const result =
          parseVLESS(
            chunk,
            userUUID
          );

        if (result.error) {
          throw new Error(
            result.message
          );
        }

        const responseHeader =
          new Uint8Array([
            result.version[0],
            0,
          ]);

        const firstData =
          chunk.slice(
            result.dataIndex
          );

        // ==================================================
        // UDP / DNS
        // ==================================================

        if (result.isUDP) {

          if (
            result.port !== 53
          ) {
            throw new Error(
              'Only DNS UDP port 53 is supported'
            );
          }

          dnsMode = true;

          const dns =
            await createDNSHandler(
              server,
              responseHeader
            );

          udpWrite =
            dns.write;

          if (
            firstData.byteLength
          ) {
            await udpWrite(
              firstData
            );
          }

          return;
        }

        // ==================================================
        // TCP
        // ==================================================

        try {

          remoteSocket =
            await connect({
              hostname:
                result.address,
              port:
                result.port,
            });

          const writer =
            remoteSocket.writable
              .getWriter();

          try {
            if (
              firstData.byteLength
            ) {
              await writer.write(
                firstData
              );
            }
          } finally {
            writer.releaseLock();
          }

          pipeRemote(
            remoteSocket,
            server,
            responseHeader
          );

        } catch (err) {

          console.error(
            'TCP connection failed:',
            err
          );

          safeClose(
            server,
            1011,
            'TCP connection failed'
          );
        }
      },

      close() {
        closeSocket(
          remoteSocket
        );
      },

      abort() {
        closeSocket(
          remoteSocket
        );
      },
    })
  ).catch((err) => {

    console.error(
      'WebSocket stream error:',
      err
    );

    closeSocket(
      remoteSocket
    );

    safeClose(
      server,
      1011,
      'Internal error'
    );
  });

  return new Response(
    null,
    {
      status: 101,
      webSocket: client,
    }
  );
}


// ============================================================
// WebSocket -> ReadableStream
// ============================================================

function createWebSocketStream(
  ws,
  earlyData
) {
  return new ReadableStream({

    start(controller) {

      ws.addEventListener(
        'message',
        event => {
          controller.enqueue(
            event.data
          );
        }
      );

      ws.addEventListener(
        'close',
        () => {
          try {
            controller.close();
          } catch {}
        }
      );

      ws.addEventListener(
        'error',
        error => {
          controller.error(
            error
          );
        }
      );

      // Early Data
      if (earlyData) {
        try {

          const data =
            decodeBase64URL(
              earlyData
            );

          if (data) {
            controller.enqueue(
              data
            );
          }

        } catch {
          // 忽略无效 early data
        }
      }
    },
  });
}


// ============================================================
// VLESS Parser
// ============================================================

function parseVLESS(
  buffer,
  userUUID
) {
  if (
    !buffer ||
    buffer.byteLength < 24
  ) {
    return {
      error: true,
      message:
        'Invalid VLESS header',
    };
  }

  try {

    const view =
      new DataView(buffer);

    const version =
      new Uint8Array(
        buffer.slice(0, 1)
      );

    const uuid =
      formatUUID(
        new Uint8Array(
          buffer.slice(1, 17)
        )
      );

    // UUID 验证
    if (
      uuid.toLowerCase() !==
      userUUID.toLowerCase()
    ) {
      return {
        error: true,
        message:
          'Invalid UUID',
      };
    }

    const optionsLength =
      view.getUint8(17);

    const commandOffset =
      18 + optionsLength;

    if (
      commandOffset >=
      buffer.byteLength
    ) {
      return {
        error: true,
        message:
          'Invalid command',
      };
    }

    const command =
      view.getUint8(
        commandOffset
      );

    let isUDP = false;

    if (command === 1) {
      // TCP
    } else if (
      command === 2
    ) {
      // UDP
      isUDP = true;
    } else {
      return {
        error: true,
        message:
          'Unsupported command',
      };
    }

    let offset =
      commandOffset + 1;

    // Port
    if (
      offset + 2 >
      buffer.byteLength
    ) {
      return {
        error: true,
        message:
          'Invalid port',
      };
    }

    const port =
      view.getUint16(offset);

    offset += 2;

    // Address type
    if (
      offset >=
      buffer.byteLength
    ) {
      return {
        error: true,
        message:
          'Missing address type',
      };
    }

    const addressType =
      view.getUint8(offset++);

    let address = '';

    // IPv4
    if (
      addressType === 1
    ) {

      if (
        offset + 4 >
        buffer.byteLength
      ) {
        return {
          error: true,
          message:
            'Invalid IPv4',
        };
      }

      address =
        Array.from(
          new Uint8Array(
            buffer.slice(
              offset,
              offset + 4
            )
          )
        ).join('.');

      offset += 4;
    }

    // Domain
    else if (
      addressType === 2
    ) {

      if (
        offset >=
        buffer.byteLength
      ) {
        return {
          error: true,
          message:
            'Invalid domain',
        };
      }

      const length =
        view.getUint8(
          offset++
        );

      if (
        offset + length >
        buffer.byteLength
      ) {
        return {
          error: true,
          message:
            'Invalid domain length',
        };
      }

      address =
        new TextDecoder()
          .decode(
            buffer.slice(
              offset,
              offset + length
            )
          );

      offset += length;
    }

    // IPv6
    else if (
      addressType === 3
    ) {

      if (
        offset + 16 >
        buffer.byteLength
      ) {
        return {
          error: true,
          message:
            'Invalid IPv6',
        };
      }

      const parts = [];

      for (
        let i = 0;
        i < 8;
        i++
      ) {

        parts.push(
          view
            .getUint16(offset)
            .toString(16)
            .padStart(
              4,
              '0'
            )
        );

        offset += 2;
      }

      address =
        parts.join(':');
    }

    else {
      return {
        error: true,
        message:
          'Unsupported address type',
      };
    }

    return {
      error: false,
      version,
      address,
      port,
      dataIndex: offset,
      isUDP,
    };

  } catch (err) {

    return {
      error: true,
      message:
        `Parse error: ${err.message}`,
    };
  }
}


// ============================================================
// Remote TCP -> WebSocket
// ============================================================

function pipeRemote(
  socket,
  ws,
  responseHeader
) {
  let headerSent = false;

  socket.readable.pipeTo(
    new WritableStream({

      write(chunk) {

        if (
          ws.readyState !==
          WS_OPEN
        ) {
          return;
        }

        if (!headerSent) {

          const output =
            new Uint8Array(
              responseHeader.byteLength +
              chunk.byteLength
            );

          output.set(
            responseHeader,
            0
          );

          output.set(
            new Uint8Array(chunk),
            responseHeader.byteLength
          );

          ws.send(
            output.buffer
          );

          headerSent = true;

        } else {

          ws.send(
            chunk
          );
        }
      },

      close() {

        safeClose(
          ws,
          1000,
          'Connection closed'
        );
      },

      abort() {

        closeSocket(
          socket
        );
      },
    })
  ).catch(err => {

    console.error(
      'Remote pipe error:',
      err
    );

    closeSocket(
      socket
    );

    safeClose(
      ws,
      1011,
      'Transfer error'
    );
  });
}


// ============================================================
// DNS UDP
// ============================================================

async function createDNSHandler(
  ws,
  responseHeader
) {
  let headerSent = false;

  const transform =
    new TransformStream({

      transform(
        chunk,
        controller
      ) {

        let offset = 0;

        while (
          offset + 2 <=
          chunk.byteLength
        ) {

          const length =
            new DataView(
              chunk.slice(
                offset,
                offset + 2
              )
            ).getUint16(0);

          offset += 2;

          if (
            offset + length >
            chunk.byteLength
          ) {
            throw new Error(
              'Invalid UDP packet'
            );
          }

          controller.enqueue(
            new Uint8Array(
              chunk.slice(
                offset,
                offset + length
              )
            )
          );

          offset += length;
        }
      },
    });

  transform.readable.pipeTo(
    new WritableStream({

      async write(chunk) {

        const response =
          await fetch(
            'https://1.1.1.1/dns-query',
            {
              method: 'POST',
              headers: {
                'content-type':
                  'application/dns-message',
              },
              body: chunk,
            }
          );

        if (!response.ok) {
          throw new Error(
            `DNS HTTP ${response.status}`
          );
        }

        const data =
          await response.arrayBuffer();

        const size =
          data.byteLength;

        const sizeBuffer =
          new Uint8Array([
            (size >> 8) & 255,
            size & 255,
          ]);

        if (
          ws.readyState !==
          WS_OPEN
        ) {
          return;
        }

        const total =
          (headerSent ? 0 :
            responseHeader.byteLength) +
          2 +
          size;

        const output =
          new Uint8Array(total);

        let offset = 0;

        if (!headerSent) {

          output.set(
            responseHeader,
            offset
          );

          offset +=
            responseHeader.byteLength;

          headerSent = true;
        }

        output.set(
          sizeBuffer,
          offset
        );

        offset += 2;

        output.set(
          new Uint8Array(data),
          offset
        );

        ws.send(
          output.buffer
        );
      },
    })
  ).catch(err => {

    console.error(
      'DNS error:',
      err
    );

    safeClose(
      ws,
      1011,
      'DNS error'
    );
  });

  const writer =
    transform.writable
      .getWriter();

  return {
    write(chunk) {
      return writer.write(
        chunk
      );
    },
  };
}


// ============================================================
// UUID
// ============================================================

function formatUUID(bytes) {

  const hex =
    Array.from(
      bytes,
      b =>
        b.toString(16)
          .padStart(2, '0')
    ).join('');

  return (
    `${hex.slice(0, 8)}-` +
    `${hex.slice(8, 12)}-` +
    `${hex.slice(12, 16)}-` +
    `${hex.slice(16, 20)}-` +
    `${hex.slice(20)}`
  );
}


function isValidUUID(uuid) {

  return /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    uuid
  );
}


// ============================================================
// Base64URL
// ============================================================

function decodeBase64URL(value) {

  let str =
    value
      .replace(/-/g, '+')
      .replace(/_/g, '/');

  while (
    str.length % 4
  ) {
    str += '=';
  }

  const binary =
    atob(str);

  const bytes =
    new Uint8Array(
      binary.length
    );

  for (
    let i = 0;
    i < binary.length;
    i++
  ) {
    bytes[i] =
      binary.charCodeAt(i);
  }

  return bytes.buffer;
}


// ============================================================
// Close helpers
// ============================================================

function closeSocket(socket) {

  if (!socket) {
    return;
  }

  try {
    socket.close();
  } catch {}
}


function safeClose(
  ws,
  code,
  reason
) {

  try {

    if (
      ws &&
      ws.readyState ===
      WS_OPEN
    ) {
      ws.close(
        code,
        reason
      );
    }

  } catch {}
}
