import { connect } from 'cloudflare:sockets';

const WS_READY_STATE_OPEN = 1;

export default {
  async fetch(request, env, ctx) {
    try {
      // 必须配置 UUID
      const userID = env.UUID;

      if (!userID) {
        return new Response('UUID environment variable is not configured', {
          status: 500,
        });
      }

      // 验证 UUID 格式
      if (!isValidUUID(userID)) {
        return new Response('Invalid UUID environment variable', {
          status: 500,
        });
      }

      const url = new URL(request.url);

      // 普通 HTTP 请求
      const upgradeHeader = request.headers.get('Upgrade');

      if (!upgradeHeader || upgradeHeader.toLowerCase() !== 'websocket') {
        // 首页
        if (url.pathname === '/') {
          return new Response('VLESS Proxy Server', {
            status: 200,
            headers: {
              'Content-Type': 'text/plain;charset=utf-8',
            },
          });
        }

        // /UUID 返回 VLESS 配置
        if (url.pathname === `/${userID}`) {
          const host = request.headers.get('Host');

          if (!host) {
            return new Response('Host header missing', {
              status: 400,
            });
          }

          const vlessConfig =
            `vless://${userID}@${host}:443` +
            `?encryption=none` +
            `&security=tls` +
            `&sni=${encodeURIComponent(host)}` +
            `&type=ws` +
            `&host=${encodeURIComponent(host)}` +
            `&path=%2F` +
            `#${encodeURIComponent(host)}`;

          return new Response(vlessConfig, {
            status: 200,
            headers: {
              'Content-Type': 'text/plain;charset=utf-8',
            },
          });
        }

        return new Response('Not Found', {
          status: 404,
        });
      }

      // WebSocket 只允许 /
      if (url.pathname !== '/') {
        return new Response('Not Found', {
          status: 404,
        });
      }

      return await handleVLESSWebSocket(
        request,
        userID
      );
    } catch (err) {
      console.error(err);

      return new Response(
        `Internal Server Error: ${err?.message || String(err)}`,
        {
          status: 500,
        }
      );
    }
  },
};


// ============================================================
// WebSocket / VLESS
// ============================================================

async function handleVLESSWebSocket(request, userID) {
  const wsPair = new WebSocketPair();

  const clientWS = wsPair[0];
  const serverWS = wsPair[1];

  serverWS.accept();

  const earlyDataHeader =
    request.headers.get('sec-websocket-protocol') || '';

  const wsReadable = createWebSocketReadableStream(
    serverWS,
    earlyDataHeader
  );

  let remoteSocket = null;
  let udpStreamWrite = null;
  let isDns = false;

  wsReadable
    .pipeTo(
      new WritableStream({
        async write(chunk) {
          try {
            // DNS UDP
            if (isDns && udpStreamWrite) {
              await udpStreamWrite(chunk);
              return;
            }

            // 已经建立 TCP
            if (remoteSocket) {
              const writer =
                remoteSocket.writable.getWriter();

              try {
                await writer.write(chunk);
              } finally {
                writer.releaseLock();
              }

              return;
            }

            // 解析 VLESS 请求
            const result = parseVLESSHeader(
              chunk,
              userID
            );

            if (result.hasError) {
              throw new Error(result.message);
            }

            const vlessRespHeader = new Uint8Array([
              result.vlessVersion[0],
              0,
            ]);

            const rawClientData =
              chunk.slice(result.rawDataIndex);

            // ------------------------------------------------
            // UDP
            // ------------------------------------------------

            if (result.isUDP) {
              // 只允许 DNS 53
              if (result.portRemote !== 53) {
                throw new Error(
                  'UDP proxy only supports DNS port 53'
                );
              }

              isDns = true;

              const udpHandler =
                await handleUDPOutBound(
                  serverWS,
                  vlessRespHeader
                );

              udpStreamWrite = udpHandler.write;

              if (rawClientData.byteLength > 0) {
                await udpStreamWrite(rawClientData);
              }

              return;
            }

            // ------------------------------------------------
            // TCP
            // ------------------------------------------------

            async function connectAndWrite(
              address,
              port
            ) {
              const tcpSocket = await connect({
                hostname: address,
                port,
              });

              remoteSocket = tcpSocket;

              const writer =
                tcpSocket.writable.getWriter();

              try {
                if (rawClientData.byteLength > 0) {
                  await writer.write(rawClientData);
                }
              } finally {
                writer.releaseLock();
              }

              return tcpSocket;
            }

            // NAT64 fallback
            async function retry() {
              try {
                const proxyIP =
                  await getIPv6ProxyAddress(
                    result.addressRemote
                  );

                console.log(
                  `Trying NAT64 address: ${proxyIP}`
                );

                const tcpSocket = await connect({
                  hostname: proxyIP,
                  port: result.portRemote,
                });

                remoteSocket = tcpSocket;

                const writer =
                  tcpSocket.writable.getWriter();

                try {
                  if (rawClientData.byteLength > 0) {
                    await writer.write(rawClientData);
                  }
                } finally {
                  writer.releaseLock();
                }

                pipeRemoteToWebSocket(
                  tcpSocket,
                  serverWS,
                  vlessRespHeader,
                  null
                );
              } catch (err) {
                console.error(
                  'NAT64 connection failed:',
                  err
                );

                safeCloseWebSocket(
                  serverWS,
                  1011,
                  'NAT64 connection failed'
                );
              }
            }

            try {
              const tcpSocket =
                await connectAndWrite(
                  result.addressRemote,
                  result.portRemote
                );

              pipeRemoteToWebSocket(
                tcpSocket,
                serverWS,
                vlessRespHeader,
                retry
              );
            } catch (err) {
              console.error(
                'TCP connection failed:',
                err
              );

              safeCloseWebSocket(
                serverWS,
                1011,
                'TCP connection failed'
              );
            }
          } catch (err) {
            console.error(
              'WebSocket write error:',
              err
            );

            closeSocket(remoteSocket);

            safeCloseWebSocket(
              serverWS,
              1011,
              'Internal error'
            );
          }
        },

        close() {
          closeSocket(remoteSocket);
        },

        abort() {
          closeSocket(remoteSocket);
        },
      })
    )
    .catch((err) => {
      console.error(
        'WebSocket stream error:',
        err
      );

      closeSocket(remoteSocket);

      safeCloseWebSocket(
        serverWS,
        1011,
        'Internal error'
      );
    });

  return new Response(null, {
    status: 101,
    webSocket: clientWS,
  });
}


// ============================================================
// WebSocket ReadableStream
// ============================================================

function createWebSocketReadableStream(
  ws,
  earlyDataHeader
) {
  return new ReadableStream({
    start(controller) {
      ws.addEventListener(
        'message',
        (event) => {
          try {
            controller.enqueue(event.data);
          } catch (err) {
            controller.error(err);
          }
        }
      );

      ws.addEventListener(
        'close',
        () => {
          try {
            controller.close();
          } catch {}
        }
      );

      ws.addEventListener(
        'error',
        (err) => {
          controller.error(err);
        }
      );

      // VLESS early data
      if (earlyDataHeader) {
        try {
          const decoded =
            base64UrlDecode(earlyDataHeader);

          if (decoded) {
            controller.enqueue(decoded);
          }
        } catch {
          // 忽略无效 early data
        }
      }
    },

    cancel() {
      try {
        ws.close();
      } catch {}
    },
  });
}


// ============================================================
// VLESS Header Parser
// ============================================================

function parseVLESSHeader(
  buffer,
  userID
) {
  if (!buffer || buffer.byteLength < 24) {
    return {
      hasError: true,
      message: 'Invalid VLESS header length',
    };
  }

  try {
    const view = new DataView(buffer);

    const version =
      new Uint8Array(buffer.slice(0, 1));

    // UUID
    const uuid = formatUUID(
      new Uint8Array(
        buffer.slice(1, 17)
      )
    );

    if (
      uuid.toLowerCase() !==
      userID.toLowerCase()
    ) {
      return {
        hasError: true,
        message: 'Invalid user UUID',
      };
    }

    // Addons length
    const optionsLength =
      view.getUint8(17);

    const commandOffset =
      18 + optionsLength;

    if (
      commandOffset >=
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message: 'Invalid command offset',
      };
    }

    const command =
      view.getUint8(commandOffset);

    let isUDP = false;

    // 01 = TCP
    // 02 = UDP
    if (command === 1) {
      isUDP = false;
    } else if (command === 2) {
      isUDP = true;
    } else {
      return {
        hasError: true,
        message:
          'Unsupported VLESS command',
      };
    }

    let offset =
      commandOffset + 1;

    // Port
    if (
      offset + 2 >
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message: 'Invalid port',
      };
    }

    const port =
      view.getUint16(offset);

    offset += 2;

    // Address type
    if (
      offset >=
      buffer.byteLength
    ) {
      return {
        hasError: true,
        message: 'Missing address type',
      };
    }

    const addressType =
      view.getUint8(offset++);

    let address = '';

    switch (addressType) {
      // IPv4
      case 1: {
        if (
          offset + 4 >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message: 'Invalid IPv4 address',
          };
        }

        address = Array.from(
          new Uint8Array(
            buffer.slice(
              offset,
              offset + 4
            )
          )
        ).join('.');

        offset += 4;

        break;
      }

      // Domain
      case 2: {
        if (
          offset >=
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Missing domain length',
          };
        }

        const domainLength =
          view.getUint8(offset++);

        if (
          offset + domainLength >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Invalid domain length',
          };
        }

        address =
          new TextDecoder().decode(
            buffer.slice(
              offset,
              offset + domainLength
            )
          );

        offset += domainLength;

        break;
      }

      // IPv6
      case 3: {
        if (
          offset + 16 >
          buffer.byteLength
        ) {
          return {
            hasError: true,
            message:
              'Invalid IPv6 address',
          };
        }

        const parts = [];

        for (let i = 0; i < 8; i++) {
          parts.push(
            view
              .getUint16(offset)
              .toString(16)
              .padStart(4, '0')
          );

          offset += 2;
        }

        address = parts.join(':');

        break;
      }

      default:
        return {
          hasError: true,
          message:
            'Unsupported address type',
        };
    }

    return {
      hasError: false,
      addressRemote: address,
      portRemote: port,
      rawDataIndex: offset,
      vlessVersion: version,
      isUDP,
    };
  } catch (err) {
    return {
      hasError: true,
      message:
        `VLESS parse error: ${err.message}`,
    };
  }
}


// ============================================================
// TCP -> WebSocket
// ============================================================

function pipeRemoteToWebSocket(
  remoteSocket,
  ws,
  vlessHeader,
  retry = null
) {
  let headerSent = false;
  let hasIncomingData = false;

  remoteSocket.readable
    .pipeTo(
      new WritableStream({
        write(chunk) {
          hasIncomingData = true;

          if (
            ws.readyState !==
            WS_READY_STATE_OPEN
          ) {
            return;
          }

          if (!headerSent) {
            const combined =
              new Uint8Array(
                vlessHeader.byteLength +
                chunk.byteLength
              );

            combined.set(
              vlessHeader,
              0
            );

            combined.set(
              new Uint8Array(chunk),
              vlessHeader.byteLength
            );

            ws.send(
              combined.buffer
            );

            headerSent = true;
          } else {
            ws.send(chunk);
          }
        },

        close() {
          if (
            !hasIncomingData &&
            retry
          ) {
            retry();
            return;
          }

          safeCloseWebSocket(
            ws,
            1000,
            'Connection closed'
          );
        },

        abort() {
          closeSocket(remoteSocket);
        },
      })
    )
    .catch((err) => {
      console.error(
        'Remote pipe error:',
        err
      );

      closeSocket(remoteSocket);

      safeCloseWebSocket(
        ws,
        1011,
        'Data transfer error'
      );
    });
}


// ============================================================
// NAT64 DNS
// ============================================================

function convertToNAT64IPv6(
  ipv4Address
) {
  const parts =
    ipv4Address.split('.');

  if (parts.length !== 4) {
    throw new Error(
      'Invalid IPv4 address'
    );
  }

  const hex = parts.map((part) => {
    const num =
      Number.parseInt(part, 10);

    if (
      !Number.isInteger(num) ||
      num < 0 ||
      num > 255
    ) {
      throw new Error(
        'Invalid IPv4 address segment'
      );
    }

    return num
      .toString(16)
      .padStart(2, '0');
  });

  return (
    `[2001:67c:2960:6464::` +
    `${hex[0]}${hex[1]}:` +
    `${hex[2]}${hex[3]}]`
  );
}


async function getIPv6ProxyAddress(
  domain
) {
  try {
    const dnsQuery =
      await fetch(
        `https://1.1.1.1/dns-query?name=${encodeURIComponent(domain)}&type=A`,
        {
          headers: {
            Accept:
              'application/dns-json',
          },
        }
      );

    if (!dnsQuery.ok) {
      throw new Error(
        `DNS HTTP ${dnsQuery.status}`
      );
    }

    const dnsResult =
      await dnsQuery.json();

    if (
      dnsResult.Answer &&
      dnsResult.Answer.length > 0
    ) {
      const aRecord =
        dnsResult.Answer.find(
          (record) =>
            record.type === 1
        );

      if (aRecord) {
        return convertToNAT64IPv6(
          aRecord.data
        );
      }
    }

    throw new Error(
      'No IPv4 DNS record found'
    );
  } catch (err) {
    throw new Error(
      `DNS resolution failed: ${err.message}`
    );
  }
}


// ============================================================
// UDP DNS
// ============================================================

async function handleUDPOutBound(
  webSocket,
  vlessResponseHeader
) {
  let isVlessHeaderSent = false;

  const transformStream =
    new TransformStream({
      transform(
        chunk,
        controller
      ) {
        let index = 0;

        while (
          index + 2 <=
          chunk.byteLength
        ) {
          const lengthBuffer =
            chunk.slice(
              index,
              index + 2
            );

          const udpPacketLength =
            new DataView(
              lengthBuffer
            ).getUint16(0);

          index += 2;

          if (
            index +
              udpPacketLength >
            chunk.byteLength
          ) {
            throw new Error(
              'Invalid UDP packet length'
            );
          }

          const udpData =
            new Uint8Array(
              chunk.slice(
                index,
                index +
                  udpPacketLength
              )
            );

          index +=
            udpPacketLength;

          controller.enqueue(
            udpData
          );
        }
      },
    });

  transformStream.readable
    .pipeTo(
      new WritableStream({
        async write(chunk) {
          const resp =
            await fetch(
              'https://1.1.1.1/dns-query',
              {
                method: 'POST',
                headers: {
                  'content-type':
                    'application/dns-message',
                },
                body: chunk,
              }
            );

          if (!resp.ok) {
            throw new Error(
              `DNS request failed: ${resp.status}`
            );
          }

          const dnsQueryResult =
            await resp.arrayBuffer();

          const udpSize =
            dnsQueryResult.byteLength;

          const udpSizeBuffer =
            new Uint8Array([
              (udpSize >> 8) & 0xff,
              udpSize & 0xff,
            ]);

          if (
            webSocket.readyState !==
            WS_READY_STATE_OPEN
          ) {
            return;
          }

          const result =
            new Uint8Array(
              vlessResponseHeader.byteLength +
              2 +
              udpSize
            );

          let offset = 0;

          if (!isVlessHeaderSent) {
            result.set(
              vlessResponseHeader,
              offset
            );

            offset +=
              vlessResponseHeader.byteLength;

            isVlessHeaderSent = true;
          }

          result.set(
            udpSizeBuffer,
            offset
          );

          offset += 2;

          result.set(
            new Uint8Array(
              dnsQueryResult
            ),
            offset
          );

          webSocket.send(
            result.buffer
          );
        },
      })
    )
    .catch((error) => {
      console.error(
        'UDP DNS error:',
        error
      );

      safeCloseWebSocket(
        webSocket,
        1011,
        'DNS error'
      );
    });

  const writer =
    transformStream.writable.getWriter();

  return {
    write(chunk) {
      return writer.write(chunk);
    },
  };
}


// ============================================================
// Helpers
// ============================================================

function formatUUID(bytes) {
  const hex =
    Array.from(
      bytes,
      (b) =>
        b.toString(16).padStart(2, '0')
    ).join('');

  return (
    `${hex.slice(0, 8)}-` +
    `${hex.slice(8, 12)}-` +
    `${hex.slice(12, 16)}-` +
    `${hex.slice(16, 20)}-` +
    `${hex.slice(20)}`
  );
}


function isValidUUID(uuid) {
  return /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(
    uuid
  );
}


function base64UrlDecode(value) {
  let str =
    value
      .replace(/-/g, '+')
      .replace(/_/g, '/');

  while (str.length % 4) {
    str += '=';
  }

  const binary =
    atob(str);

  const bytes =
    new Uint8Array(
      binary.length
    );

  for (
    let i = 0;
    i < binary.length;
    i++
  ) {
    bytes[i] =
      binary.charCodeAt(i);
  }

  return bytes.buffer;
}


function closeSocket(socket) {
  if (!socket) {
    return;
  }

  try {
    socket.close();
  } catch {}
}


function safeCloseWebSocket(
  ws,
  code,
  reason
) {
  try {
    if (
      ws &&
      ws.readyState ===
        WS_READY_STATE_OPEN
    ) {
      ws.close(code, reason);
    }
  } catch {}
}
